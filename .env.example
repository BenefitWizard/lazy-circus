# Lazy Circus demo environment variables
# Copy this file to .env and fill in the values before running ./run-example.sh

# Telegram bot token (optional)
# If not set, Telegram scenario is skipped.
TG_TOKEN=

# Telegram chat id for sending messages (optional)
# Must be a valid integer when TG_TOKEN is set.
TG_CHAT_ID=

# AI service API key (optional)
# If not set, AI scenario is skipped.
AI_API_KEY=

# AI service base URL (optional)
# Defaults to https://api.deepseek.com when AI_API_KEY is set and no value is provided.
AI_BASE_URL="https://api.deepseek.com"

# SMTP / mail server settings
# Default SMTP host is 127.0.0.1, e.g. mailpit container on port 1025.
SMTP_HOST=127.0.0.1
SMTP_LOGIN=
SMTP_PASSWORD=

# Notification email for bot events (optional)
# When set, the bot sends an email when a new act is created.
NOTIFICATION_EMAIL=
